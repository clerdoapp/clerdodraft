{
  "name": "clerdodraft",
  "productName": "ClerdoDraft",
  "version": "0.1.0",
  "description": "Free, open-source word processor by Clerdo",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Clerdo",
    "email": "support@clerdo.app"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "dist": "npm run build && npm run electron:compile && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.0.0",
    "@fontsource/caladea": "^5.0.0",
    "@fontsource/carlito": "^5.0.0",
    "@fontsource/cousine": "^5.0.0",
    "@fontsource/hanken-grotesk": "^5.0.0",
    "@fontsource/noto-naskh-arabic": "^5.0.0",
    "@fontsource/tinos": "^5.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.460.0",
    "nspell": "^2.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "app.clerdo.clerdodraft",
    "productName": "ClerdoDraft",
    "directories": {
      "output": "release",
      "buildResources": "brand/build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Clerdo"
    },
    "artifactName": "clerdodraft-${version}-${os}-${arch}.${ext}",
    "deb": {
      "artifactName": "clerdodraft-${version}-linux-amd64.deb"
    },
    "rpm": {
      "artifactName": "clerdodraft-${version}-linux-x86_64.rpm"
    },
    "publish": []
  },
  "homepage": "https://clerdo.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/clerdoapp/clerdodraft.git"
  }
}