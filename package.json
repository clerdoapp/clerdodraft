    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "app.clerdo.clerdodraft",
    "productName": "ClerdoDraft",
    "directories": {
      "output": "release",
      "buildResources": "brand/build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Clerdo"
    },
    "artifactName": "clerdodraft-${version}-${os}-${arch}.${ext}",
    "deb": {
      "artifactName": "clerdodraft-${version}-linux-amd64.deb"
    },
    "rpm": {
      "artifactName": "clerdodraft-${version}-linux-x86_64.rpm"
    },
    "publish": []
  },
  "homepage": "https://clerdo.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/clerdoapp/clerdodraft.git"
  }
}
