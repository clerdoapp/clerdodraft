{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "electron", "vite.config.ts"]
}
